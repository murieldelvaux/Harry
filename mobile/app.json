{
  "expo": {
    "name": "Harry",
    "slug": "harry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/harry-logo.png",
    "scheme": "harry",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/harry-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.harry.couple",
      "icon": "./assets/harry-logo.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.harry.couple",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D12"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/harry-logo.png",
      "name": "Harry",
      "shortName": "Harry",
      "backgroundColor": "#0B0D12",
      "themeColor": "#0B0D12"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/harry-logo.png",
          "color": "#6366F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fdc22022-76cf-423b-859c-08d204b72ab5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fdc22022-76cf-423b-859c-08d204b72ab5"
    }
  }
}
