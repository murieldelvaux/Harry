{
  "name": "nexo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nexo — Assistente pessoal e financeiro compartilhado, com ingestão via WhatsApp",
  "workspaces": [
    "packages/*",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,web\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:all": "concurrently -n \"backend,mobile\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:backend": "npm run --workspace=backend start:dev",
    "dev:mobile": "npm run --workspace=mobile start -- --go",
    "dev:mobile:tunnel": "npm run --workspace=mobile start -- --tunnel",
    "build:shared": "npm run --workspace=packages/shared build",
    "db:migrate": "npm run --workspace=backend prisma:migrate",
    "db:studio": "npm run --workspace=backend prisma:studio",
    "db:seed": "npm run --workspace=backend prisma:seed",
    "login": "npm --workspace=mobile exec -- expo login",
    "build:backend": "npm run build:shared && npm run --workspace=backend prisma:generate && npm run --workspace=backend build",
    "start:backend": "npm run --workspace=backend prisma:deploy && npm run --workspace=backend start:prod",
    "dev:web": "npm run --workspace=mobile start -- --web",
    "build:web": "npm run build:shared && npm run --workspace=mobile build:web"
  },
  "keywords": [
    "nexo",
    "couple-finances",
    "whatsapp-assistant",
    "react-native",
    "nestjs",
    "prisma"
  ],
  "author": "Nexo Team",
  "license": "UNLICENSED",
  "overrides": {
    "query-string": "7.1.3"
  },
  "dependencies": {
    "query-string": "7.1.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.6"
  }
}
