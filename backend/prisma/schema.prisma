datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RecordScope {
  PRIVATE
  SHARED
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum ExpenseCategory {
  HOUSING
  FOOD_MARKET
  RESTAURANT
  TRANSPORTATION
  HEALTH
  LEISURE
  UTILITIES
  SUBSCRIPTIONS
  SALARY
  INVESTMENT
  FREELANCE
  SALE
  OTHER
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String?
  name         String
  phoneNumber  String?     @unique
  googleId     String?     @unique
  avatarUrl    String?
  resetToken   String?
  resetExpires DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  householdId  String?
  household    Household?  @relation(fields: [householdId], references: [id], onDelete: SetNull)

  expenses     Expense[]
  goals        Goal[]
  tasks        Task[]
  shoppingItems ShoppingItem[]
  dailySummaryTime      String?   @default("06:00")
  enableDailySummary    Boolean   @default(true)
  periodicSummaryType   String?   @default("WEEKLY")
  periodicSummaryDay    Int?      @default(1)
  lastDailySummaryDate  String?
  lastPeriodicDate      String?
  googleAccessToken     String?
  googleRefreshToken    String?
  calendarEvents        CalendarEvent[]
  sharePrivateExpenses  Boolean   @default(false)

  @@index([phoneNumber])
}

model Household {
  id          String    @id @default(uuid())
  name        String    @default("Nossa Casa")
  inviteCode  String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     User[]
  expenses    Expense[]
  goals       Goal[]
  tasks       Task[]
  shoppingItems ShoppingItem[]
  dailySummaryTime      String?   @default("06:00")
  enableDailySummary    Boolean   @default(true)
  periodicSummaryType   String?   @default("WEEKLY")
  periodicSummaryDay    Int?      @default(1)
  lastDailySummaryDate  String?
  lastPeriodicDate      String?
  googleAccessToken     String?
  googleRefreshToken    String?
  calendarEvents        CalendarEvent[]
}

model Expense {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType @default(EXPENSE)
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  scope       RecordScope     @default(PRIVATE)
  rawSource   String?

  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String?
  household   Household?      @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, scope])
  @@index([householdId, scope])
  @@index([date])
}

model Goal {
  id            String      @id @default(uuid())
  title         String
  targetAmount  Decimal     @db.Decimal(10, 2)
  currentAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  targetDate    DateTime?
  status        GoalStatus  @default(IN_PROGRESS)
  scope         RecordScope @default(SHARED)

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId   String?
  household     Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([householdId])
}

model Task {
  id              String      @id @default(uuid())
  title           String
  dueDate         DateTime?
  hasSpecificTime Boolean     @default(false)
  reminderSent    Boolean     @default(false)
  isCompleted     Boolean     @default(false)
  scope           RecordScope @default(SHARED)

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String?
  household   Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, isCompleted])
  @@index([householdId, isCompleted])
}

model ProcessedWebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model ShoppingItem {
  id          String      @id @default(uuid())
  name        String
  quantity    String?     @default("1")
  category    String?     @default("Geral")
  isCompleted Boolean     @default(false)
  scope       RecordScope @default(SHARED)

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String?
  household   Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([householdId, isCompleted])
  @@index([userId, isCompleted])
}

model CalendarEvent {
  id               String      @id @default(uuid())
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  isAllDay         Boolean     @default(false)
  location         String?
  googleEventId    String?
  googleCalendarId String?     @default("primary")
  color            String?
  colorId          String?
  etag             String?
  scope            RecordScope @default(SHARED)
  attendees        String?

  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId      String?
  household        Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, startDate])
  @@index([householdId, startDate])
  @@index([googleEventId])
  @@index([googleCalendarId])
}

model GoogleCalendarSyncState {
  id             String    @id @default(uuid())
  userId         String
  calendarId     String
  calendarName   String?
  backgroundColor String?
  foregroundColor String?
  channelId      String?   @unique
  resourceId     String?
  expiration     DateTime?
  syncToken      String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, calendarId])
  @@index([userId])
  @@index([channelId])
}

